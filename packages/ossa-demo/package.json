{
	"name": "ossa-demo",
	"version": "1.9.2",
	"private": true,
	"description": "OSSA Demo",
	"privite": true,
	"templateInfo": {
		"name": "default",
		"typescript": true,
		"css": "sass"
	},
	"scripts": {
		"build:weapp": "taro build --type weapp",
		"build:swan": "taro build --type swan",
		"build:alipay": "taro build --type alipay",
		"build:tt": "taro build --type tt",
		"build:h5": "taro build --type h5",
		"build:h5:vercel": "taro build --type h5 --public_path=/",
		"build:rn": "taro build --type rn",
		"build:qq": "taro build --type qq",
		"build:jd": "taro build --type jd",
		"build:quickapp": "taro build --type quickapp",
    "build:harmony": "taro build --type harmony",
		"dev:weapp": "npm run build:weapp -- --watch",
		"dev:swan": "npm run build:swan -- --watch",
		"dev:alipay": "npm run build:alipay -- --watch",
		"dev:tt": "npm run build:tt -- --watch",
		"dev:h5": "npm run build:h5 -- --watch",
		"dev:rn": "npm run build:rn -- --watch",
		"dev:qq": "npm run build:qq -- --watch",
		"dev:jd": "npm run build:jd -- --watch",
		"dev:quickapp": "npm run build:quickapp -- --watch",
    "dev:harmony": "npm run build:harmony -- --watch",
		"test": "cypress run",
		"test:background": "node ../../scripts/testBg.js",
		"test:open": "cypress open",
		"test:report": "allure generate ./test/results --clean && allure open allure-report"
	},
	"browserslist": [
		"last 3 versions",
		"Android >= 4.1",
		"ios >= 8"
	],
	"author": "",
	"dependencies": {
		"@babel/runtime": "^7.24.4",
		"@ossa/loki": "workspace:^1.0.0",
		"@tarojs/components": "4.0.6",
		"@tarojs/helper": "4.0.6",
		"@tarojs/plugin-framework-react": "4.0.6",
		"@tarojs/plugin-html": "4.0.6",
		"@tarojs/plugin-platform-alipay": "4.0.6",
		"@tarojs/plugin-platform-h5": "4.0.6",
		"@tarojs/plugin-platform-harmony-ets": "^4.0.6",
		"@tarojs/plugin-platform-jd": "4.0.6",
		"@tarojs/plugin-platform-qq": "4.0.6",
		"@tarojs/plugin-platform-swan": "4.0.6",
		"@tarojs/plugin-platform-tt": "4.0.6",
		"@tarojs/plugin-platform-weapp": "4.0.6",
		"@tarojs/react": "4.0.6",
		"@tarojs/router": "4.0.6",
		"@tarojs/runtime": "4.0.6",
		"@tarojs/shared": "4.0.6",
		"@tarojs/taro": "4.0.6",
		"@tarojs/taro-h5": "4.0.6",
		"ossaui": "workspace:^0.7.4",
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"devDependencies": {
		"@babel/core": "^7.24.4",
		"@babel/preset-react": "^7.24.1",
		"@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
		"@tarojs/cli": "4.0.6",
		"@tarojs/vite-runner": "4.0.6",
		"@tarojs/webpack5-runner": "4.0.6",
		"@types/react": "^18.0.0",
		"@types/webpack-env": "^1.13.6",
		"@typescript-eslint/eslint-plugin": "^5.20.0",
		"@typescript-eslint/parser": "^5.20.0",
		"@vitejs/plugin-react": "^4.3.0",
		"allure-commandline": "^2.9.0",
		"babel-plugin-import": "^1.13.5",
		"babel-preset-taro": "4.0.6",
		"cypress": "^3.4.1",
		"cypress-file-upload": "^3.3.3",
		"cypress-junit": "0.0.2",
		"eslint": "^8.12.0",
		"eslint-config-taro": "4.0.6",
		"eslint-plugin-import": "^2.12.0",
		"eslint-plugin-react": "^7.8.2",
		"eslint-plugin-react-hooks": "^4.2.0",
		"mocha": "^6.1.4",
		"mocha-allure-reporter": "^1.4.0",
		"react-refresh": "^0.14.0",
		"stylelint": "^14.4.0",
		"terser": "^5.30.4",
		"typescript": "^5.4.5",
		"vite": "^4.2.0",
		"webpack": "5.69.0",
		"yargs": "^17.5.1"
	}
}
